{
  "name": "claude-agent-sdk-lesson-02",
  "version": "1.0.0",
  "private": true,
  "description": "A Lesson 2 workbench for Claude Agent SDK TypeScript 0.3.310: real tools, MCP, core exports, settings and constants.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/tool.test.ts test/exports.test.ts test/server.test.ts test/live.test.ts",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "live:cli": "tsx src/examples/agent-query.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "tool:demo": "tsx src/examples/call-tool.ts",
    "exports": "tsx src/examples/inspect-exports.ts",
    "settings": "tsx src/examples/inspect-settings.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
